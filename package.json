{
  "name": "d-eagle-hub",
  "main": "desktop/main.cjs",
  "version": "1.0.0",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "crypto-js": "^4.2.0",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-server-sdk": "^7.2.0",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-speech-recognition": "^57.0.0",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "mysql2": "^3.24.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "superjson": "^2.2.6",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.10",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "desktop:build-web": "expo export --platform web --output-dir web-build",
    "desktop": "npm run desktop:build-web&& electron .",
    "desktop:pack": "npm run desktop:build-web&& electron-builder --win portable --x64",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "npm run typecheck && npm run test",
    "release:gate": "node scripts/release-gate.mjs",
    "desktop:verify": "npm run desktop:build-web"
  },
  "private": true,
  "build": {
    "appId": "com.deaglehub.desktop",
    "productName": "D-Eagle Hub",
    "copyright": "D-Eagle Hub",
    "directories": {
      "buildResources": "desktop",
      "output": "desktop-release"
    },
    "files": [
      "desktop/**/*",
      "web-build/**/*",
      "package.json"
    ],
    "asar": true,
    "portable": {
      "artifactName": "D-Eagle-Hub-Portable.exe"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "D-Eagle-Hub-Portable.exe"
    },
    "compression": "store"
  }
}